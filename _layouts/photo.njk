{% extends "base.njk" %}

{% set mainClass = "photo" %}

{# This page's default language version `page` object #}
{% set defaultPage = alternativeKey | get_bare('page', site.defaultLanguage) %}

{% if projectKey %}
  {% set limit = 3 if (previousPhoto and nextPhoto) else 4 %}

  {% set previousPhoto = collections['photos'] | projectfilter(projectKey) | getPreviousCollectionItem(defaultPage) %}
  {% set nextPhoto = collections['photos'] | projectfilter(projectKey) | getNextCollectionItem(defaultPage) %}

  {% set exclusions = [
    previousPhoto.data.alternativeKey,
    alternativeKey,
    nextPhoto.data.alternativeKey
  ] %}
{% else %}
  {% set limit = 5 %}
  {% set exclusions = [ alternativeKey ] %}
{% endif %}

{% set randomCollection = collections['photos'] | projectfilter(projectKey) | exclude(exclusions) | shuffle | limit_to(limit) %}

{% block content %}
  <section>
    <h1>{{ title }}</h1>
    <figure class="frame" style="--custom-background: {{ imageMetadata.dominantColour if imageMetadata.dominantColour else "var(--wizard_grey)"}};">
      {% if image %}
        {% image image, "alt", "100w" %}
      {% endif %}
      <figcaption class="frame__caption">
        {{ content | safe }}
      </figcaption>
    </figure>
  </section>

  <aside class="related-photos">
    {% if previousPhoto %}
      <div class="previous-photo">
        {{ previousPhoto.data.alternativeKey | get('title') | link_to(previousPhoto.data.alternativeKey) | add_class('previous-link')  | add_rel('previous')}}
        {% image previousPhoto.data.alternativeKey | get_bare('image'), "", "100vw" %}
      </div>
    {% endif %}

    {% if randomCollection | length > 0 %}
      {% for r in randomCollection %}
        <div class="random-photos">
          {{ r.data.alternativeKey | get('title') | link_to(r.data.alternativeKey) | add_class('random-link') }}
          {% image r.data.alternativeKey | get_bare('image'), "", "100vw" %}
        </div>
      {% endfor %}
    {% endif %}

    {% if nextPhoto %}
      <div class="next-photo">
        {{ nextPhoto.data.alternativeKey | get('title') | link_to(nextPhoto.data.alternativeKey) | add_class('next-link') | add_rel('next') }}
        {% image nextPhoto.data.alternativeKey | get_bare('image'), "", "100vw" %}
      </div>
    {% endif %}
  </aside>
{% endblock %}