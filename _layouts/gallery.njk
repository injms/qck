{% extends "base.njk" %}

{% block content %}
    <h1>{{ 'projects' | i18n(language) }}</h1>
    {% for project in collections.projects %}
      <a href="#{{ project.key | slugify }}">#</a>
      <h2>
        {{ ("project:" + project.key) | i18n | speciesify | add_id(project.key | slugify) }}
      </h2>

      <ul class="photo-list" data-list-length="{{ project.collection | length }}">
        {% for photo in project.collection %}
            <li class="photo-list__item">
              <figure class="photo-list__item-frame">
                <figcaption class="photo-list__item-caption">
                  {{ photo.data.alternativeKey | get_bare('title') | link_to(photo.data.alternativeKey) | add_class('photo-list__item-link') }}
                </figcaption>
                {% if photo.data.image %}
                  {% image photo.data.image, "", "100vw" %}
                {% endif %}
              </figure>
            </li>
        {% endfor %}
      </ul>
    {% endfor %}


{% endblock %}
